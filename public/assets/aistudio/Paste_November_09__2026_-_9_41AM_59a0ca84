let currentLang = localStorage.getItem('lang') || 'pt';
if (!['pt','en','bg'].includes(currentLang)) currentLang = 'pt';

/* ══════════════════════════════════════════════════════════
   TRADUÇÃO
══════════════════════════════════════════════════════════ */
function applyLang(lang){
  const dict = T[lang];
  if (!dict) return;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const v = dict[el.dataset.i18n];
    if (v) el.textContent = v;
  });
  document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
    const v = dict[el.dataset.i18nPlaceholder];
    if (v) el.placeholder = v;
  });
  document.querySelectorAll('.lang-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.lang === lang);
  });
  document.documentElement.lang = lang === 'pt' ? 'pt-PT' : lang;
  localStorage.setItem('lang', lang);
  currentLang = lang;
}

/* ══════════════════════════════════════════════════════════
   SIDEBAR
══════════════════════════════════════════════════════════ */
function openSidebar(){
  document.getElementById('sidebar').classList.add('open');
  document.getElementById('sidebarOverlay').classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebarOverlay').classList.remove('active');
  document.body.style.overflow = '';
}

/* ══════════════════════════════════════════════════════════
   SPA ROUTER
══════════════════════════════════════════════════════════ */
function goTo(pageId, pushHash = true){
  const target = document.getElementById('page-' + pageId);
  if (!target) return;

  document.querySelectorAll('.page').forEach(p => p.classList.remove('page--active'));
  target.classList.add('page--active');

  const anims = target.querySelectorAll('[data-anim]');
  anims.forEach((el, i) => {
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
    el.style.animationDelay = (0.05 + i * 0.07) + 's';
  });

  document.querySelectorAll('.sidebar__nav a').forEach(a => {
    a.classList.toggle('active', a.dataset.page === pageId);
  });

  if (pushHash) {
    try { history.replaceState(null, '', '#' + pageId); }
    catch(_) { location.hash = '#' + pageId; }
  }

  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (window.innerWidth <= 1024) closeSidebar();
  applyLang(currentLang);
}

/* ══════════════════════════════════════════════════════════
   PARALLAX NO SCROLL
══════════════════════════════════════════════════════════ */
function initParallax(){
  const layers = document.querySelectorAll('.parallax-layer');
  if (!layers.length) return;

  let ticking = false;
  function update(){
    const scrolled = window.pageYOffset;
    layers.forEach(layer => {
      const speed = parseFloat(layer.dataset.speed) || 0.2;
      layer.style.transform = `translateY(${scrolled * speed}px)`;
    });
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(update);
      ticking = true;
    }
  }, { passive: true });
  update();
}

/* ══════════════════════════════════════════════════════════
   STATS ANIMADAS
══════════════════════════════════════════════════════════ */
function animateCount(el, target){
  const start = performance.now();
  function tick(now){
    const t = Math.min((now - start) / 1500, 1);
    const ease = 1 - Math.pow(1 - t, 3);
    el.textContent = Math.round(target * ease);
    if (t < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}
const statsObserver = new IntersectionObserver(entries => {
  entries.forEach(en => {
    if (en.isIntersecting) {
      const el = en.target;
      const target = parseInt(el.dataset.count, 10);
      if (!isNaN(target)) animateCount(el, target);
      statsObserver.unobserve(el);
    }
  });
}, { threshold: 0.4 });

/* ══════════════════════════════════════════════════════════
   INICIALIZAÇÃO
══════════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {

  applyLang(currentLang);

  window.addEventListener('load', () => {
    setTimeout(() => document.getElementById('loader').classList.add('loader--hidden'), 1800);
  });

  document.getElementById('year').textContent = new Date().getFullYear();

  document.querySelectorAll('.lang-btn').forEach(b => {
    b.addEventListener('click', () => applyLang(b.dataset.lang));
  });

  document.getElementById('sidebarToggle').addEventListener('click', () => {
    document.getElementById('sidebar').classList.contains('open') ? closeSidebar() : openSidebar();
  });
  document.getElementById('sidebarClose').addEventListener('click', closeSidebar);
  document.getElementById('sidebarOverlay').addEventListener('click', closeSidebar);

  document.addEventListener('click', e => {
    const link = e.target.closest('a[href^="#"]');
    if (!link) return;
    const id = link.getAttribute('href').replace('#','');
    if (document.getElementById('page-' + id)) {
      e.preventDefault();
      goTo(id);
    }
  });

  document.querySelectorAll('[data-modal]').forEach(btn => {
    btn.addEventListener('click', () => {
      const m = document.getElementById('modal-' + btn.dataset.modal);
      if (m) m.classList.add('modal--visible');
    });
  });
  document.querySelectorAll('.modal').forEach(m => {
    const close = m.querySelector('.modal__close');
    if (close) close.addEventListener('click', () => m.classList.remove('modal--visible'));
    m.addEventListener('click', e => {
      if (e.target === m) m.classList.remove('modal--visible');
    });
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeSidebar();
      document.querySelectorAll('.modal.modal--visible').forEach(m => m.classList.remove('modal--visible'));
    }
  });

  const form = document.getElementById('bookingForm');
  if (form) {
    form.addEventListener('submit', e => {
      e.preventDefault();
      document.getElementById('modal-booking').classList.add('modal--visible');
      form.reset();
    });
  }

  const initial = location.hash.replace('#','') || 'scientific';
  goTo(initial, false);

  window.addEventListener('hashchange', () => {
    const id = location.hash.replace('#','') || 'scientific';
    if (document.getElementById('page-' + id)) goTo(id, false);
  });

  const aboutPage = document.getElementById('page-about');
  if (aboutPage) {
    aboutPage.querySelectorAll('[data-count]').forEach(el => statsObserver.observe(el));
  }

  initParallax();
});